+  
+  const opoka = data.opokas.find(o => String(o.id) === String(b.stages[2].opokaId));
+  const gatingWeight = opoka ? (opoka.gating_weight || 0) : 0;
+  const totalWax = (b.stages[1].waxUsed || 0) + gatingWeight;
+  
+  const metalId = document.getElementById("s4_mat_metal_"+bid).value;
+  const metal = data.materials.find(m => String(m.id) === String(metalId));
+  
+  if (metal && metal.density > 0) {
+    const theoretical = totalWax * metal.density;
+    document.getElementById("s4_theoretical_"+bid).textContent = `≈ ${fmt(theoretical, 3)} г`;
+  } else {
+    document.getElementById("s4_theoretical_"+bid).textContent = `(плотность не указана)`;
+  }
+}
+
