+
+headers = {
+    "Authorization": WB_TOKEN
+}
+
+def test_connection():
+    print("Подключаемся к Wildberries...")
+    
+    # Запрос к API контента (получение списка карточек)
+    url = "https://content-api.wildberries.ru/content/v2/get/cards/list"
+    
+    payload = {
+        "settings": {
+            "cursor": {
+                "limit": 5  # Запрашиваем всего 5 товаров для теста
+            },
+            "filter": {
+                "withPhoto": -1 
+            }
+        }
+    }
+    
+    try:
+        response = requests.post(url, headers=headers, json=payload)
+        
+        if response.status_code == 200:
+            data = response.json()
+            cards = data.get("cards", [])
+            print(f"✅ Успех! Связь есть. Получено товаров: {len(cards)}")
+            
+            for card in cards:
+                title = card.get("title") or "Без названия"
+                nm_id = card.get("nmID")
+                print(f"- Товар: {title} (Артикул WB: {nm_id})")
+                
+        else:
+            print(f"❌ Ошибка. Код ответа: {response.status_code}")
+            print(f"Текст ошибки: {response.text}")
+            
+    except Exception as e:
+        print(f"❌ Ошибка выполнения: {e}")
+
+if __name__ == "__main__":
+    test_connection()

