+const cardsHTML = colTasks.map(t => `
+  <div style="background: #fff; border: 1px solid #ccc; border-radius: 4px; padding: 8px; margin-bottom: 8px; box-shadow: 0 1px 2px rgba(0,0,0,0.1); cursor:pointer;" onclick="openTaskModal('${t.id}')">
+    ${t.photo ? `<img src="${escapeHtml(t.photo)}" style="width:100%; height:100px; object-fit:cover; border-radius:4px; margin-bottom:6px;">` : ''}
+    <div style="font-weight: 600; font-size: 13px; margin-bottom: 4px;">${escapeHtml(t.title)}</div>
+    ${t.note ? `<div style="font-size:11px; color:#888; margin-bottom:4px;">${escapeHtml(t.note.slice(0,30))}...</div>` : ''}
+    <div style="display: flex; justify-content: space-between; gap: 4px;">
+      <button class="action" style="padding: 2px 6px; font-size: 10px;" onclick="event.stopPropagation(); deleteBoardTask('${t.id}')">×</button>
+      <div>
+        <button class="action" style="padding: 2px 6px; font-size: 10px;" onclick="event.stopPropagation(); moveBoardTask('${t.id}', 'left')">←</button>
+        <button class="action" style="padding: 2px 6px; font-size: 10px;" onclick="event.stopPropagation(); moveBoardTask('${t.id}', 'right')">→</button>
+      </div>
+    </div>
+  </div>
+`).join("");
+
+return `
+  <div style="min-width: 220px; max-width: 260px; background: #f5f5f5; border-radius: 6px; padding: 12px; border: 1px solid #ddd; display: flex; flex-direction: column;">
+    <div style="display:flex; justify-content:space-between; margin-bottom:8px; align-items:center;">
