+Привет, Aider! Есть баг с наложением интерфейса: когда я открываю любой чат в разделе "Сообщения", поверх него появляется окно календаря (или другого раздела). Это происходит потому, что при открытии чата не скрываются остальные вкладки в разделе "Компания".
+
+Исправь это. Найди функцию openChat(chatId) в файле index.html и замени её на эту. В ней добавлено принудительное скрытие всех остальных вкладок при открытии чата:
+
+javascript
+function openChat(chatId) {
+  const user = getCurrentUser(); if (!user) return;
+  const chat = (data.chats || []).find(c => String(c.id) === String(chatId));
+  if (!chat) return alert("Чат не найден");
+  
+  // ПРИНУДИТЕЛЬНО переключаем интерфейс
+  const companyBtn = document.querySelector(".main-tabs button[onclick*='company']");
+  if (companyBtn) showMain("company", companyBtn);
+  
+  const chatTabBtn = document.querySelector("#main-company .tabs button[onclick*='chat']");
+  if (chatTabBtn) {
+    // Вручную скрываем ВСЕ вкладки в разделе Компания
+    document.querySelectorAll("#main-company .tab").forEach(t => t.classList.remove("active"));
+    document.querySelectorAll("#main-company > .tabs button").forEach(b => b.classList.remove("active"));
+    
+    // Включаем только вкладку чата
+    document.getElementById("company-chat").classList.add("active");
+    chatTabBtn.classList.add("active");
+  }
+
+  // А ТЕПЕРЬ (после всех переключений) устанавливаем ID чата!
+  _currentChatId = chatId;
+  
+  document.getElementById("chat_title").textContent = chat.title || "Без названия";
+  document.querySelector("#company-chat > .card").style.display = "none";
+  document.getElementById("chat_window").style.display = "block";
+  renderChatParticipants(chatId);
+  renderChatMessages(chatId);
+  setTimeout(() => { const inp = document.getElementById("chat_input"); if (inp) inp.focus(); }, 100);
+}
+Также проверь функцию closeChatWindow(). Убедись, что она выглядит так (чтобы при закрытии чата возвращался список всех чатов, а не календарь):
+
+javascript
+function closeChatWindow() {
+  _currentChatId = null;
+  document.getElementById("chat_window").style.display = "none";
+  document.querySelector("#company-chat > .card").style.display = "block";
+  
+  // Если мы находимся в архиве чатов, не перерисовываем основной список
+  const archivedChatsTab = document.getElementById("service-archive_chats");
+  if (archivedChatsTab && archivedChatsTab.classList.contains("active")) {
+    // Ничего не делаем
+  } else {
+    renderChats();
+  }
+}
+Выполни эти замены. Теперь при клике на чат остальные вкладки будут гарантированно скрываться, и поверх не будет вылезать календарь.

