+Привет, Aider! Нужно внести финальные изменения для учёта плотности и литника. Сделай 4 шага.
+
+1. В HTML, в блоке добавления материала (Сервис -> Склад материалов), после селекта "Тип" добавь поле для плотности:
+<input id="m_density" type="number" step="0.01" placeholder="Плотность (г/см³)" style="width:130px">
+
+2. В HTML, в блоке добавления опоки (Сервис -> Справочники -> Размеры опок), после поля "Вода" добавь поле для веса литника:
+<input id="o_gating" type="number" step="0.1" placeholder="Вес литника, г" style="width:130px">
+
+3. В функции addMaterial() добавь сохранение плотности:
+data.materials.push({ 
+  id: uid(), name, 
+  brand: document.getElementById("m_brand").value.trim(), 
+  unit: document.getElementById("m_unit").value || "г", 
+  price: +document.getElementById("m_price").value || 0, 
+  stock: stockVal || 0,
+  infinite: (stockVal >= 999999),
+  type: document.getElementById("m_type").value || "",
+  density: +document.getElementById("m_density").value || 0 // <-- ДОБАВИТЬ
+});
+
+4. В функции addOpoka() добавь сохранение веса литника:
+data.opokas.push({ 
+  id: uid(), name, 
+  mass: +document.getElementById("o_mass").value || 0, 
+  water: +document.getElementById("o_water").value || 0, 
+  matMass: +document.getElementById("o_mass_mat_sel").value || null, 
+  matWater: +document.getElementById("o_water_mat_sel").value || null,
+  gating_weight: +document.getElementById("o_gating").value || 0 // <-- ДОБАВИТЬ
+});
+
+5. В функции renderMaterials() добавь отображение плотности:
+Найди заголовок таблицы и добавь колонку:
+<thead><tr><th>Название</th><th>Тип</th><th>Плотность</th><th>Бренд</th><th>Ед.</th><th>Цена</th><th>Остаток</th><th>Пополнить</th><th></th></tr></thead>
+
+И в строках добавь ячейку:
+<td>${m.density ? fmt(m.density) : "—"}</td>
+
+6. В функции renderOpokas() добавь отображение веса литника:
+Найди заголовок таблицы и добавь колонку:
+<thead><tr><th>Название</th><th>Формомасса</th><th>Литник, г</th><th>Материал</th><th>Вода</th><th>Материал</th><th></th></tr></thead>
+
+И в строках добавь ячейку:
+<td>${o.gating_weight ? fmt(o.gating_weight) : "—"} г</td>
+
+7. В функции renderBatchCard() замени блок этапа 1 на этот (добавлен выбор воска):
+if (!s[1].done) {
+  const norm = p.normWax * b.qty;
+  html += `<div class="stage ${st===1?'active':''}"><div class="stage-title">1. Создание восковок ${st===1?'<span class="badge badge-active">активен</span>':''}</div><div class="stage-info">Норма: ${fmt(norm,3)} г воска. Выберите воск и введите вес:</div>`;
+  if (st === 1) {
+    html += `<div class="row">
+      <select id="s1_wax_${b.id}">${data.materials.filter(m => m.type === 'wax').map(m => `<option value="${m.id}">${escapeHtml(m.name)}</option>`).join("")}</select>
+      <input id="s1_${b.id}" type="number" step="0.001" placeholder="Вес воска, г">
+      <input type="file" id="s1_photo_${b.id}" accept="image/*" style="display:none" onchange="uploadStagePhoto('${b.id}', 1, this)">
+      <button class="action" onclick="document.getElementById('s1_photo_${b.id}').click()">📷 Фото</button>
+      <button class="action ok" onclick="completeStage1(${b.id})">Этап завершён</button>
+    </div>`;
+  }
+  html += `</div>`;
+} else {
+  html += `<div class="stage done"><div class="stage-title">1. Восковки <span class="badge badge-done">завершён</span></div><div class="stage-info">Использовано: ${fmt(s[1].waxUsed,3)} г — ${fmt(b.stageCosts[1])} ₽</div></div>`;
+}
+
+8. В функции completeStage1() замени начало на:
+function completeStage1(bid) {
+  const b = data.batches.find(x => String(x.id) === String(bid)); 
+  if (!b) return alert("Партия не найдена. Обновите страницу (F5).");
+  
+  const p = data.products.find(x => String(x.id) === String(b.productId));
+  if (!p) return alert("Изделие удалено. Удалите партию и создайте заново.");
+  
+  const waxId = document.getElementById("s1_wax_"+bid).value;
+  const used = +document.getElementById("s1_"+bid).value || 0;
+  if (used <= 0) return alert("Укажите вес воска");
+  if (!waxId) return alert("Выберите воск");
+  
+  const cost = writeOffMaterial(waxId, used, true); 
+  if (cost === null) return;
+  
+  b.stages[1].waxUsed = used; 
+  b.stages[1].waxId = waxId;
+  b.stages[1].done = true; 
+  b.stageCosts[1] = cost; 
+  b.stage = 2; 
+  
+  save(); 
+  renderBatches();
+}
+
+9. В функции renderBatchCard() замени блок этапа 4 на этот (добавлен расчёт теоретического веса):
+if (s[3].done && !s[4].done) {
+  const opoka = data.opokas.find(o => String(o.id) === String(s[2].opokaId));
+  const gatingWeight = opoka ? (opoka.gating_weight || 0) : 0;
+  const totalWax = (s[1].waxUsed || 0) + gatingWeight;
+  
+  html += `<div class="stage ${st===4?'active':''}"><div class="stage-title">4. Литьё ${st===4?'<span class="badge badge-active">активен</span>':''}</div>`;
+  html += `<div class="stage-info">Вес воска с литником: <b>${fmt(totalWax,3)} г</b></div>`;
+  html += `<div class="stage-info">Выберите металл (теоретический вес рассчитается автоматически):</div>`;
+  
+  if (st === 4) {
+    html += `<div class="row">
+      <select id="s4_mat_metal_${b.id}" onchange="calcTheoreticalMetal(${b.id})">${data.materials.filter(m => m.type === 'metal').map(m => `<option value="${m.id}">${escapeHtml(m.name)}</option>`).join("")}</select>
+      <span id="s4_theoretical_${b.id}" style="font-weight:600; color:#2b6cb0;"></span>
+      <input id="s4_used_${b.id}" type="number" step="0.001" placeholder="Факт. использовано, г">
+      <input id="s4_ret_${b.id}" type="number" step="0.001" placeholder="Возврат, г" value="0">
+      <input type="file" id="s4_photo_${b.id}" accept="image/*" style="display:none" onchange="uploadStagePhoto('${b.id}', 4, this)">
+      <button class="action" onclick="document.getElementById('s4_photo_${b.id}').click()">📷 Фото</button>
+      <button class="action ok" onclick="completeStage4(${b.id})">Этап завершён</button>
+    </div>`;
+  }
+  html += `</div>`;
+} else if (s[4].done) {
+  html += `<div class="stage done"><div class="stage-title">4. Литьё <span class="badge badge-done">завершён</span></div><div class="stage-info">Использовано: ${fmt(s[4].metalUsed,3)} г, возврат: ${fmt(s[4].metalReturned,3)} г — ${fmt(b.stageCosts[4])} ₽</div></div>`;
+}
+
+10. Добавь новую функцию после renderBatchCard:
+function calcTheoreticalMetal(bid) {
+  const b = data.batches.find(x => String(x.id) === String(bid));
+  if (!b) return;
+  
+  const opoka = data.opokas.find(o => String(o.id) === String(b.stages[2].opokaId));
+  const gatingWeight = opoka ? (opoka.gating_weight || 0) : 0;
+  const totalWax = (b.stages[1].waxUsed || 0) + gatingWeight;
+  
+  const metalId = document.getElementById("s4_mat_metal_"+bid).value;
+  const metal = data.materials.find(m => String(m.id) === String(metalId));
+  
+  if (metal && metal.density > 0) {
+    const theoretical = totalWax * metal.density;
+    document.getElementById("s4_theoretical_"+bid).textContent = `≈ ${fmt(theoretical, 3)} г`;
+  } else {
+    document.getElementById("s4_theoretical_"+bid).textContent = `(плотность не указана)`;
+  }
+}
+
+Готово. Выполни эти замены.

