# 2026-10-24 12:41:20.075956
+Роль: Ты — senior frontend-разработчик. Твоя задача — внести два точечных улучшения в существующий файл index.html (SPA на чистом JS + Supabase). Приложение — CRM для ювелирного производства.
+
+Контекст: В приложении уже работает система уведомлений (addNotification). Уведомления приходят в реальном времени через Supabase, сохраняются в базу и отображаются в колокольчике. Есть сотрудники с ролями master (сотрудник) и admin (руководитель). Текущий пользователь определяется через getCurrentUser().
+
+Задача: Добавить отправку уведомлений руководителям (у кого role === 'admin'), когда сотрудник выполняет задачу или завершает производственный этап. Важно не отправлять уведомление, если действие совершил сам руководитель.
+
+Правка 1: Уведомление при выполнении задачи в календаре
+Найди функцию toggleTaskDone(id, dateStr = null). Внутри неё есть блок else, где задача просто переключает статус done.
+
+Найди этот фрагмент:
+
+javascript
+  } else {
+    // Для обычных задач используем старую логику
+    t.done = !t.done;
+    t.updatedAt = new Date().toISOString();
+    const chat = (data.chats || []).find(c => String(c.linked_id) === String(t.id));
+    if (chat) {
+      if (t.done) { chat.archived = true; showToast("📦 Чат задачи перенесён в архив", "success"); } 
+      else { chat.archived = false; }
+      chat.updatedAt = new Date().toISOString();
+    }
+  }
+Замени его на этот код (добавлен блок с уведомлением админов):
+
+javascript
+  } else {
+    // Для обычных задач используем старую логику
+    t.done = !t.done;
+    t.updatedAt = new Date().toISOString();
+    const chat = (data.chats || []).find(c => String(c.linked_id) === String(t.id));
+    if (chat) {
+      if (t.done) { chat.archived = true; showToast("📦 Чат задачи перенесён в архив", "success"); } 
+      else { chat.archived = false; }
+      chat.updatedAt = new Date().toISOString();
+    }
+    
+    // НОВОЕ: Уведомление руководителям о выполнении задачи
+    if (t.done) {
+      const currentUser = getCurrentUser();
+      if (currentUser) {
+        const admins = (data.employees || []).filter(e => e.role === 'admin');
+        admins.forEach(admin => {
+          if (String(admin.id) !== String(currentUser.id)) {
+            addNotification(
+              admin.id,
+              'task_completed',
+              'Задача выполнена',
+              `${currentUser.name} выполнил(а) задачу "${t.title || 'Без названия'}"`,
+              `task:${t.id}`
+            );
+          }
+        });
+      }
+    }
+  }
+Правка 2: Уведомление при завершении этапа производства
+Найди функцию completeStageN(bid, stageNum). В самом конце этой функции (перед save(); renderBatches();) находится такой код:
+
+javascript
+  save(); 
+  renderBatches(); 
+  if (b.finished) renderStock();
+  renderCalendar();
+Замени его на этот код (перед сохранением добавлен блок уведомлений):
+
+javascript
+  // НОВОЕ: Уведомление руководителям о завершении этапа
+  const currentUser = getCurrentUser();
+  if (currentUser && currentUser.role !== 'admin') { 
+    const admins = (data.employees || []).filter(e => e.role === 'admin');
+    const stageNames = {5:"Обработка", 6:"Гальваника", 7:"Чернение", 8:"Упаковка"};
+    
+    admins.forEach(admin => {
+      if (String(admin.id) !== String(currentUser.id)) {
+        if (b.finished) {
+          addNotification(
+            admin.id,
+            'batch_completed',
+            'Партия завершена',
+            `${currentUser.name} завершил(а) партию #${b.id} (${b.productName} × ${b.qty} шт)`,
+            `batch:${b.groupId || b.id}`
+          );
+        } else {
+          addNotification(
+            admin.id,
+            'stage_completed',
+            'Этап производства завершен',
+            `${currentUser.name} завершил(а) этап "${stageNames[stageNum] || 'Производство'}" в партии #${b.id} (${b.productName})`,
+            `batch:${b.groupId || b.id}`
+          );
+        }
+      }
+    });
+  }
+
+  save(); 
+  renderBatches(); 
+  if (b.finished) renderStock();
+  renderCalendar();
+Требования:
+
+Не переписывать другие функции.
+
+Использовать существующие getCurrentUser(), addNotification().
+
+Не ломать проверку currentUser.role !== 'admin' (уведомления должны приходить только руководителям, если действие совершил не он).
+
+После правок приложение должно работать без ошибок в консоли.

