+function topUp(id) {
+  const m = matById(id); 
+  if (!m) return;
+  
+  const v = window.prompt(`Сколько добавить "${m.name}" на склад? (Текущий: ${m.infinite ? '∞' : m.stock})`);
+  
+  if (v === null || v.trim() === "") return;
+  
+  const amount = parseFloat(v.replace(',', '.'));
+  
+  if (isNaN(amount) || amount === 0) {
+    return showToast("❌ Введите корректное число", "error");
+  }
+
+  m.stock = (+m.stock || 0) + amount;
+  if (m.stock >= 999999) m.infinite = true;
+  
+  m.updatedAt = new Date().toISOString(); 
+  
+  save(); 
+  renderMaterials(); 
+  showToast(`✅ Добавлено ${amount} ${m.unit} (${m.name})`, "success");
+}
