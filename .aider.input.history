+Найди функцию renderWbStocks. Замени её полное содержимое на этот код:
+
+async function renderWbStocks() {
+  const table = document.getElementById('wb-stocks-table');
+  if (!table) return;
+  
+  table.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:rgba(255,255,255,0.5);">Загрузка данных...</td></tr>';
+  
+  try {
+    const sb = await initCloud();
+    if (!sb) {
+      table.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:#f87171;">Ошибка подключения к облаку</td></tr>';
+      return;
+    }
+    
+    const { data: wbStocks, error } = await sb.from('wb_stocks').select('*');
+    if (error) throw error;
+    
+    if (!wbStocks || wbStocks.length === 0) {
+      table.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:rgba(255,255,255,0.5);">Нет данных о товарах на Wildberries</td></tr>';
+      return;
+    }
+    
+    let html = '';
+    wbStocks.forEach(wbItem => {
+      let stockItem = null;
+      let productName = wbItem.title || `Товар WB: ${wbItem.nm_id}`;
+      let article = wbItem.article || '—';
+      
+      if (article !== '—') {
+        stockItem = (data.stock || []).find(item => 
+          item.productName && article && 
+          item.productName.toLowerCase().includes(article.toLowerCase())
+        );
+        if (!stockItem) {
+          const product = (data.products || []).find(p => 
+            p.article && article && 
+            p.article.toLowerCase() === article.toLowerCase()
+          );
+          if (product) {
+            stockItem = (data.stock || []).find(item => 
+              item.productName === product.name
+            );
+          }
+        }
+      }
+      
+      const fbsQty = wbItem.fbs_quantity || 0;
+      const fboQty = wbItem.fbo_quantity || 0;
+      const wbTotal = fbsQty + fboQty;
+      const myStockQty = stockItem ? stockItem.remaining : 0;
+      const cost = stockItem ? stockItem.costPerUnit : 0;
+      
+      let status = '', statusColor = '';
+      if (!stockItem) { status = '❓ Нет в РУСИЧЪ'; statusColor = 'color: #60a5fa;'; }
+      else if (wbTotal > myStockQty) { status = '⚠️ Меньше на складе'; statusColor = 'color: #f87171;'; }
+      else if (wbTotal < myStockQty) { status = '⚠️ Больше на складе'; statusColor = 'color: #fbbf24;'; }
+      else { status = '✅ ОК'; statusColor = 'color: #4ade80;'; }
+      
+      html += `
+        <tr>
+          <td>${escapeHtml(productName)}</td>
+          <td>${escapeHtml(article)}</td>
+          <td>${fbsQty}</td>
+          <td>${fboQty}</td>
+          <td>${wbTotal}</td>
+          <td>${myStockQty}</td>
+          <td>${fmt(cost)} ₽</td>
+          <td style="${statusColor} font-weight: 600;">${status}</td>
+        </tr>
+      `;
+    });
+    table.innerHTML = html;
+  } catch (error) {
+    console.error('Ошибка загрузки данных WB:', error);
+    table.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:#c53030;">Ошибка загрузки данных: ' + escapeHtml(error.message) + '</td></tr>';
+  }
+}
+
+
+Найди в теге <style> блок с комментарием /* КАЛЕНДАРЬ */ и замени стили для .calendar-grid .day на эти (добавь новый класс .today.selected):
+
+  .calendar-grid .day {
+    min-height: 80px; padding: 10px; background: #fff; color: var(--ink);
+    border-radius: var(--r-md); cursor: pointer; display: flex; flex-direction: column;
+    transition: all 0.25s var(--bounce); border: 1px solid transparent;
+  }
+  .calendar-grid .day:hover:not(.empty) { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15); z-index: 10; }
+  .calendar-grid .day:active:not(.empty) { transform: scale(0.92); }
+  .calendar-grid .day.empty { background: transparent; cursor: default; }
+  
+  /* Сегодня - Янтарный фон */
