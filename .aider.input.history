+Привет, Aider! Нужно исправить 4 критические ошибки в index.html. 
+Ничего не добавляй и не меняй логику. Просто исправь эти баги.
+
+1. В функции writeOffMaterial добавь вызов save() перед return:
+function writeOffMaterial(matId, qty, strict = false) {
+  const m = matById(matId); if (!m) return 0;
+  if (!m.infinite && strict && (+m.stock || 0) < qty) {
+    showToast(`Недостаточно материала "${m.name}": нужно ${fmt(qty,3)}, на складе ${fmt(m.stock,3)}. Списание отменено.`, "error");
+    return null;
+  }
+  const cost = qty * m.price;
+  if (!m.infinite) {
+    m.stock = +((+m.stock || 0) - qty).toFixed(3);
+    m.updatedAt = new Date().toISOString();
+  }
+  save(); // <-- ДОБАВИТЬ ЭТУ СТРОКУ
+  return +cost.toFixed(2);
+}
+
+2. В функции completeStage1 добавь save() перед renderBatches():
+  b.stages[1].waxUsed = used; 
+  b.stages[1].done = true; 
+  b.stageCosts[1] = cost; 
+  b.stage = 2; 
+  save(); // <-- ДОБАВИТЬ ЭТУ СТРОКУ
+  renderBatches();
+
+3. В функции renderBatchCard добавь вызов renderAllMaterialSelects() в самом начале:
+function renderBatchCard(b) {
+  if (typeof renderAllMaterialSelects === 'function') renderAllMaterialSelects(); // <-- ДОБАВИТЬ ЭТУ СТРОКУ
+  const p = data.products.find(x => x.id === b.productId); if (!p) return "";
+  // ... остальной код
+}
+
+4. В функции saveContractorFromModal убери поле updatedAt из объекта updatedContractor, чтобы не было ошибки с базой:
+async function saveContractorFromModal() {
+    const contractorId = document.getElementById('edit_contractor_id').value;
+    if (!contractorId) return showToast('Ошибка: ID контрагента не найден', 'error');
+
+    const contractor = data.contractors.find(c => String(c.id) === String(contractorId));
+    if (!contractor) return showToast('Контрагент не найден', 'error');
+
+    const updatedContractor = {
+        name: document.getElementById('edit_contractor_name').value.trim(),
+        address: document.getElementById('edit_contractor_address').value.trim(),
+        phone: document.getElementById('edit_contractor_phone').value.trim(),
+        email: document.getElementById('edit_contractor_email').value.trim(),
+        contact_person: document.getElementById('edit_contractor_contact_person').value.trim(),
+        inn: document.getElementById('edit_contractor_inn').value.trim(),
+        status: document.getElementById('edit_contractor_status').value,
+        notes: document.getElementById('edit_contractor_notes').value.trim()
+        // updatedAt УБРАТЬ, его нет в базе
+    };
+
+    if (!updatedContractor.name) return showToast('Введите название контрагента', 'warn');
+
+    try {
+        const sb = await initCloud();
+        if (!sb) throw new Error('Нет подключения к Supabase');
+
+        const { error } = await sb.from('contractors').update(updatedContractor).eq('id', contractorId);
+        if (error) throw error;
+
+        Object.assign(contractor, updatedContractor);
+        save();
+        closeContractorModal();
+        if (typeof renderContractorsInCategory === 'function') renderContractorsInCategory();
+        else if (typeof renderContractors === 'function') renderContractors();
+        
+        showToast('✅ Данные контрагента обновлены', 'success');
+    } catch (error) {
+        console.error('Ошибка сохранения контрагента:', error);
+        showToast('❌ Ошибка сохранения: ' + error.message, 'error');
+    }
+}
+
+Готово. Выполни эти замены.

