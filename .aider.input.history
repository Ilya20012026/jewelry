+Промт для AI-агента
+Роль: Ты — senior frontend-разработчик. Работаешь с SPA на чистом JS + Supabase (файлы index.html, cloud.js, autosync.js).
+
+Проблема:
+
+При нажатии на «Выполнено» в календаре задача возвращается в статус «не выполнено» через 15 секунд (когда срабатывает autosync). Это происходит потому, что локальное изменение не успевает отправиться в облако, и autosync скачивает старую версию из базы.
+
+Уведомление о выполнении задачи и завершении этапа производства не приходит руководителю (админу).
+
+Задача: Внести точечные правки в index.html, чтобы принудительно отправлять изменения в облако сразу после действия и корректно генерировать уведомления.
+
+Правка 1: Уведомление и мгновенная отправка при выполнении задачи в календаре
+Найди функцию toggleTaskDone(id, dateStr = null).
+Внутри неё есть блок else (для обычных задач). Найди конец этого блока:
+
+javascript
+    // НОВОЕ: Уведомление руководителям о выполнении задачи
+    if (t.done) {
+      const currentUser = getCurrentUser();
+      if (currentUser) {
+        const admins = (data.employees || []).filter(e => e.role === 'admin');
+        admins.forEach(admin => {
+          if (String(admin.id) !== String(currentUser.id)) {
+            addNotification(
+              admin.id,
+              'task_completed',
+              'Задача выполнена',
+              `${currentUser.name} выполнил(а) задачу "${t.title || 'Без названия'}"`,
+              `task:${t.id}`
+            );
+          }
+        });
+      }
+    }
+  }
+Замени этот блок на следующий (добавлена принудительная отправка в облако через pushAll):
+
+javascript
+    // НОВОЕ: Уведомление руководителям о выполнении задачи
+    if (t.done) {
+      const currentUser = getCurrentUser();
+      if (currentUser) {
+        const admins = (data.employees || []).filter(e => e.role === 'admin');
+        admins.forEach(admin => {
+          if (String(admin.id) !== String(currentUser.id)) {
+            addNotification(
+              admin.id,
+              'task_completed',
+              'Задача выполнена',
+              `${currentUser.name} выполнил(а) задачу "${t.title || 'Без названия'}"`,
+              `task:${t.id}`
+            );
+          }
+        });
+      }
+    }
+  }
+  
+  // Принудительно отправляем изменения в облако, чтобы автосинхронизация не затёрла статус
+  if (typeof pushAll === 'function') {
+    pushAll(data).catch(e => console.warn("Синхронизация отложена:", e.message));
+  }
+Правка 2: Мгновенная отправка при завершении этапа производства
+Найди функцию completeStageN(bid, stageNum).
+В самом конце этой функции, перед строками save(); renderBatches();, найди блок с уведомлениями:
+
+javascript
+  // НОВОЕ: Уведомление руководителям о завершении этапа
+  const currentUser = getCurrentUser();
+  if (currentUser && currentUser.role !== 'admin') { 
+    const admins = (data.employees || []).filter(e => e.role === 'admin');
+    const stageNames = {5:"Обработка", 6:"Гальваника", 7:"Чернение", 8:"Упаковка"};
+    
+    admins.forEach(admin => {
+      if (String(admin.id) !== String(currentUser.id)) {
+        if (b.finished) {
+          addNotification(
+            admin.id,
+            'batch_completed',
+            'Партия завершена',
+            `${currentUser.name} завершил(а) партию #${b.id} (${b.productName} × ${b.qty} шт)`,
+            `batch:${b.groupId || b.id}`
+          );
+        } else {
+          addNotification(
+            admin.id,
+            'stage_completed',
+            'Этап производства завершен',
+            `${currentUser.name} завершил(а) этап "${stageNames[stageNum] || 'Производство'}" в партии #${b.id} (${b.productName})`,
+            `batch:${b.groupId || b.id}`
+          );
+        }
+      }
+    });
+  }
+
+  save(); 
+  renderBatches(); 
+Замени этот кусок на следующий (добавлен вызов pushAll перед сохранением):
+
+javascript
+  // НОВОЕ: Уведомление руководителям о завершении этапа
+  const currentUser = getCurrentUser();
+  if (currentUser && currentUser.role !== 'admin') { 
+    const admins = (data.employees || []).filter(e => e.role === 'admin');
+    const stageNames = {5:"Обработка", 6:"Гальваника", 7:"Чернение", 8:"Упаковка"};
+    
+    admins.forEach(admin => {
+      if (String(admin.id) !== String(currentUser.id)) {
+        if (b.finished) {
+          addNotification(
+            admin.id,
+            'batch_completed',
+            'Партия завершена',
+            `${currentUser.name} завершил(а) партию #${b.id} (${b.productName} × ${b.qty} шт)`,
+            `batch:${b.groupId || b.id}`
+          );
+        } else {
+          addNotification(
+            admin.id,
+            'stage_completed',
+            'Этап производства завершен',
+            `${currentUser.name} завершил(а) этап "${stageNames[stageNum] || 'Производство'}" в партии #${b.id} (${b.productName})`,
+            `batch:${b.groupId || b.id}`
+          );
+        }
+      }
+    });
+  }
+
+  // Принудительная отправка в облако
+  if (typeof pushAll === 'function') {
+    pushAll(data).catch(e => console.warn("Синхронизация отложена:", e.message));
+  }
+
+  save(); 
+  renderBatches(); 
+Требования:
+
+Ничего не менять в cloud.js и autosync.js.
+
+Не трогать существующую логику чатов, досок и других функций.
+
+После правок статус задачи не должен откатываться назад, а уведомления должны приходить руководителям.

