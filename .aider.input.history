# 2026-10-24 14:36:22.934355
+В файле index.html найди блок `// 4. Логика напоминаний (Обед и Конец дня)` и полностью замени старый `setInterval` на этот новый код, который показывает блокирующие модалки вместо простых всплывашек:
+
+// 4. Логика напоминаний (Обед и Конец дня) - НОВАЯ БЛОКИРУЮЩАЯ СИСТЕМА
+setInterval(() => {
+  const user = getCurrentUser();
+  if (!user) return;
+  
+  const now = new Date();
+  const currentTime = now.getHours().toString().padStart(2,'0') + ":" + now.getMinutes().toString().padStart(2,'0');
+  const st = data.settings[0] || { lunch_start: "13:00", lunch_end: "13:45", work_end: "16:40" };
+  const today = now.toISOString().slice(0,10);
+
+  // --- ОБЕД ---
+  if (currentTime >= st.lunch_start && currentTime < st.lunch_end) {
+    const myShift = (data.shifts || []).find(s => s.employee_id === user.id && s.date === today && s.status === "active");
+    if (myShift && !myShift.lunch_done) {
+      const lunchModal = document.getElementById("lunch_modal");
+      if (lunchModal && lunchModal.style.display !== "flex") {
+        lunchModal.style.display = "flex";
+        showToast("🍲 Начался обеденный перерыв", "info");
+      }
+    }
+  }
+
+  // --- КОНЕЦ ДНЯ ---
+  if (currentTime >= st.work_end) {
+    const myShift = (data.shifts || []).find(s => s.employee_id === user.id && s.date === today && s.status === "active");
+    if (myShift && !myShift.end_day_done) {
+      const endModal = document.getElementById("end_day_modal");
+      if (endModal && endModal.style.display !== "flex") {
+        endModal.style.display = "flex";
+        showToast("🌙 Рабочий день заканчивается", "info");
+      }
+    }
+  }
+}, 30000); // Проверка каждые 30 секунд
+
+// Функция для кнопки "Вернуться к работе"
+function endLunch() {
+  const user = getCurrentUser();
+  if (!user) return;
+  const today = new Date().toISOString().slice(0,10);
+  const myShift = (data.shifts || []).find(s => s.employee_id === user.id && s.date === today && s.status === "active");
+  
+  if (myShift) {
+    myShift.lunch_done = true;
+    myShift.lunch_end_time = new Date().toLocaleTimeString("ru-RU", { hour: '2-digit', minute: '2-digit' });
+    save();
+  }
+  document.getElementById("lunch_modal").style.display = "none";
+}
+
+// Функция для кнопки "Понятно" (конец дня)
+function acknowledgeEndDay() {
+  const user = getCurrentUser();
+  if (!user) return;
+  const today = new Date().toISOString().slice(0,10);
+  const myShift = (data.shifts || []).find(s => s.employee_id === user.id && s.date === today && s.status === "active");
+  
+  if (myShift) {
+    myShift.end_day_done = true;
+    myShift.end_day_ack_time = new Date().toLocaleTimeString("ru-RU", { hour: '2-digit', minute: '2-digit' });
+    save();
+  }
+  document.getElementById("end_day_modal").style.display = "none";
+  
+  // Автоматически открываем окно закрытия смены
+  if (typeof renderShiftEndModal === 'function') {
+     const myShift = (data.shifts || []).find(s => s.employee_id === user.id && s.date === today && s.status === "active");
+     if (myShift) {
+         renderShiftEndModal(myShift);
+         document.getElementById("shift_end_modal").style.display = "flex";
+     }
+  }
+}

