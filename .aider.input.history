# 2026-10-22 22:17:29.232094
+Мы сломали скрипт, когда пытались добавить "В пути". Сейчас используется метод statistics-api, который выдает 404, и FBS стал нулевым.
+
+Верни функцию get_fbs_stocks к тому виду, который работал идеально (использовал seller-analytics-api):
+1. URL: https://seller-analytics-api.wildberries.ru/api/analytics/v1/stocks-report/seller-warehouses
+2. Метод POST.
+3. Возвращай словарь в формате { "nm_id": {"qty": число, "in_way": 0} } (in_way просто 0, так как WB его не отдает).
+
+Вот готовый код функции:
+def get_fbs_stocks(nm_ids):
+    url = "https://seller-analytics-api.wildberries.ru/api/analytics/v1/stocks-report/seller-warehouses"
+    try:
+        response = requests.post(url, headers=headers, json={})
+        if response.status_code == 200:
+            data = response.json()
+            items = data.get("data", {}).get("items", [])
+            result = {str(nm_id): {"qty": 0, "in_way": 0} for nm_id in nm_ids}
+            for item in items:
+                nm_id = str(item.get('nmId'))
+                if nm_id in result:
+                    result[nm_id]["qty"] += item.get('quantity', 0)
+            return result
+        else:
+            print(f"❌ Ошибка FBS: {response.status_code} - {response.text}")
+            return {}
+    except Exception as e:
+        print(f"❌ Ошибка FBS: {e}")
+        return {}

