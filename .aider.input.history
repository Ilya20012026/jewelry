+// --- СИСТЕМА НАСТРОЕК СМЕН ПО СОТРУДНИКАМ ---
+function renderShiftSettingsEmployees() {
+  const tbody = document.getElementById("shifts_employees_table");
+  if (!tbody) return;
+  
+  const emps = data.employees || [];
+  tbody.innerHTML = emps.map(emp => {
+    const ss = emp.shift_settings || {};
+    const isEnabled = ss.enabled !== false;
+    const work = (ss.work_start || "09:30") + " – " + (ss.work_end || "16:40");
+    const lunch = (ss.lunch_start || "13:00") + " – " + (ss.lunch_end || "13:45");
+    const statusBadge = isEnabled 
+      ? '<span style="color:#4ade80; font-weight:bold;">🟢 Включен</span>' 
+      : '<span style="color:#f87171; font-weight:bold;">🔴 Выключен</span>';
+      
+    return `
+      <tr>
+        <td><b>${escapeHtml(emp.name)}</b><br><small style="color:#888;">${emp.role === 'admin' ? 'Руководитель' : 'Сотрудник'}</small></td>
+        <td>${work}</td>
+        <td>${lunch}</td>
+        <td>${statusBadge}</td>
+        <td><button class="action" onclick="openShiftSettingsModal('${emp.id}')" style="padding:4px 8px;">✏️ Настроить</button></td>
+      </tr>
+    `;
+  }).join("") || '<tr><td colspan="5" style="text-align:center;">Нет сотрудников</td></tr>';
+}
+
+let _currentShiftEmpId = null;
+
+function openShiftSettingsModal(empId) {
+  const emp = (data.employees || []).find(e => String(e.id) === String(empId));
+  if (!emp) return;
+  _currentShiftEmpId = empId;
+  
+  const ss = emp.shift_settings || {};
+  
+  document.getElementById("shift_emp_modal_title").textContent = "Настройки смены: " + emp.name;
+  document.getElementById("shift_emp_enabled").checked = ss.enabled !== false;
+  document.getElementById("shift_emp_work_start").value = ss.work_start || "09:30";
+  document.getElementById("shift_emp_work_end").value = ss.work_end || "16:40";
+  document.getElementById("shift_emp_lunch_start").value = ss.lunch_start || "13:00";
+  document.getElementById("shift_emp_lunch_end").value = ss.lunch_end || "13:45";
+  document.getElementById("shift_emp_checklist").value = (ss.checklist || []).join(", ");
+  
+  document.getElementById("shift_emp_modal").style.display = "flex";
+}
+
+function saveShiftEmpSettings() {
+  if (!_currentShiftEmpId) return;
+  const emp = (data.employees || []).find(e => String(e.id) === String(_currentShiftEmpId));
+  if (!emp) return;
+
+  emp.shift_settings = {
+    enabled: document.getElementById("shift_emp_enabled").checked,
+    work_start: document.getElementById("shift_emp_work_start").value || "09:30",
+    work_end: document.getElementById("shift_emp_work_end").value || "16:40",
+    lunch_start: document.getElementById("shift_emp_lunch_start").value || "13:00",
+    lunch_end: document.getElementById("shift_emp_lunch_end").value || "13:45",
+    checklist: document.getElementById("shift_emp_checklist").value.split(",").map(s => s.trim()).filter(Boolean)
+  };
+
+  save();
+  renderShiftSettingsEmployees();
+  document.getElementById("shift_emp_modal").style.display = "none";
+  showToast("✅ Настройки смены обновлены", "success");
+}
