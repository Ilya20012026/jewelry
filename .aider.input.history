# 2026-10-23 04:08:44.488714
+Привет, Aider! После переноса вкладок в верхнюю панель (в шапку) сломалась навигация. Нужно исправить все функции, которые ищут кнопки и контент не там, где нужно. Сделай точечные замены.
+
+1. Функция showTab
+Она должна переключать вкладки внутри активного раздела (main-section) и активировать кнопку в соответствующем блоке вкладок в шапке (например, #production-tabs).
+
+Замени функцию на эту:
+
+javascript
+function showTab(id, btn) {
+  const activeMainSection = document.querySelector('.main-section.active');
+  if (!activeMainSection) return;
+
+  // 1. Скрываем все вкладки внутри активного раздела
+  activeMainSection.querySelectorAll(":scope > .tab").forEach(t => t.classList.remove("active"));
+
+  // 2. Снимаем активность с кнопок в верхней панели для этого раздела
+  const mainId = activeMainSection.id.replace('main-', '');
+  const tabsContainer = document.getElementById(mainId + '-tabs');
+  if (tabsContainer) {
+    tabsContainer.querySelectorAll('button').forEach(b => b.classList.remove('active'));
+  }
+
+  // 3. Показываем нужную вкладку и активируем кнопку
+  const targetTab = document.getElementById(id);
+  if (targetTab) targetTab.classList.add("active");
+  if (btn) btn.classList.add("active");
+
+  // 4. Загрузка данных (без изменений)
+  if (id === "stock") renderStock();
+  if (id === "supplies") {
+    const respSelect = document.getElementById("sup_responsible");
+    if (respSelect) {
+      respSelect.innerHTML = `<option value="">— Ответственный —</option>` + 
+        (data.employees || []).map(e => `<option value="${escapeHtml(e.name)}">${escapeHtml(e.name)}</option>`).join("");
+    }
+    renderSupplyStockSelect(); 
+    if(typeof loadCategoriesToSupplySelect === 'function') {
+        loadCategoriesToSupplySelect().then(() => {
+          const categorySelect = document.getElementById("sup_category");
+          if (categorySelect && categorySelect.value) {
+            loadContractorsToSupplySelect(categorySelect.value);
+          } else {
+            loadContractorsToSupplySelect(null);
+          }
+        });
+    }
+    renderSupplies(); 
+  }
+  if (id === "archive") renderArchive();
+  if (id === "batches") renderBatches();
+}
+2. Функция showCompanyTab
+Она должна скрывать все вкладки в разделе «Компания» и включать только нужную. Для вкладки «Аналитика» нужно показывать первую вкладку Wildberries.
+
+Замени функцию на эту:
+
+javascript
+function showCompanyTab(id, btn) {
+  const mainCompany = document.getElementById('main-company');
+  if (!mainCompany) return;
+
+  // Скрываем все вкладки
+  mainCompany.querySelectorAll(":scope > .tab").forEach(t => t.classList.remove("active"));
+
+  // Снимаем active с кнопок в верхней панели
+  const companyTabs = document.getElementById('company-tabs');
+  if (companyTabs) {
+    companyTabs.querySelectorAll('button').forEach(b => b.classList.remove('active'));
+  }
+
+  // Показываем нужную вкладку
+  document.getElementById("company-" + id).classList.add("active");
+  if (btn) btn.classList.add("active");
+
+  if (id === "employees") renderEmployees();
+  if (id === "boards") renderBoards();
+  
+  if (id === "chat") {
+    renderChats();
+    if (!_currentChatId) {
+      document.getElementById("chat_window").style.display = "none";
+      document.querySelector("#company-chat > .card").style.display = "block";
+    }
+  } else if (id === "analytics") {
+    // Показываем вкладку "Остатки" внутри аналитики
+    const wbStocksBtn = document.querySelector('#company-analytics .tabs button[onclick*="stocks"]');
+    if (wbStocksBtn) {
+      showWbTab('stocks', wbStocksBtn);
+    }
+  } else {
+    document.getElementById("chat_window").style.display = "none";
+    _currentChatId = null;
+  }
+}
+3. Функция openChat
+Она должна принудительно переключать интерфейс на вкладку «Сообщения», чтобы календарь не перекрывал чат.
+
+Замени функцию на эту:
+
+javascript
+function openChat(chatId) {
+  const user = getCurrentUser(); if (!user) return;
+  const chat = (data.chats || []).find(c => String(c.id) === String(chatId));
+  if (!chat) return alert("Чат не найден");
+  
+  // 1. Переключаем главный раздел на "Компания"
+  const companyBtn = document.querySelector(".main-tabs button[onclick*='company']");
+  if (companyBtn) showMain("company", companyBtn);
+  
+  // 2. Принудительно скрываем ВСЕ вкладки внутри раздела "Компания"
+  document.querySelectorAll("#main-company > .tab").forEach(t => {
+    t.classList.remove("active");
+    t.style.display = "none"; // <-- ЖЕСТКО СКРЫВАЕМ
+  });
+  
+  // 3. Снимаем активность со всех кнопок в верхней панели (company-tabs)
+  const companyTabs = document.getElementById('company-tabs');
+  if (companyTabs) {
+    companyTabs.querySelectorAll('button').forEach(b => b.classList.remove('active'));
+  }
+
+  // 4. Включаем только вкладку "Сообщения"
+  const chatTab = document.getElementById("company-chat");
+  if (chatTab) {
+    chatTab.classList.add("active");
+    chatTab.style.display = "block"; // <-- ПРИНУДИТЕЛЬНО ПОКАЗЫВАЕМ
+  }
+  
+  // 5. Активируем кнопку "Сообщения" в верхней панели
+  if (companyTabs) {
+    const chatBtn = Array.from(companyTabs.querySelectorAll('button')).find(b => b.textContent.includes('Сообщения'));
+    if (chatBtn) chatBtn.classList.add('active');
+  }
+
+  // 6. Устанавливаем ID чата и показываем окно переписки
+  _currentChatId = chatId;
+  document.getElementById("chat_title").textContent = chat.title || "Без названия";
+  
+  // Скрываем карточку со списком чатов и показываем окно чата
+  const chatListCard = document.querySelector("#company-chat > .card");
+  if (chatListCard) chatListCard.style.display = "none";
+  document.getElementById("chat_window").style.display = "block";
+  
+  renderChatParticipants(chatId);
+  renderChatMessages(chatId);
+  setTimeout(() => { const inp = document.getElementById("chat_input"); if (inp) inp.focus(); }, 100);
+}
+4. Функция openTaskChat
+Она должна корректно открывать чат из задачи в календаре.
+
+Замени функцию на эту:
+
+javascript
+async function openTaskChat(linkedId, title) {
+  const user = getCurrentUser();
+  if (!user) return alert("Войдите заново");
+  let chat = (data.chats || []).find(c => String(c.linked_id) === String(linkedId));
+  
+  if (!chat) {
+    chat = { id: "c_" + Date.now() + "_" + Math.floor(Math.random()*1000), type: "task", title: "📦 " + title, linked_id: String(linkedId), linked_type: linkedId.startsWith("batch_") ? "batch" : "task", pinned: false, created_by: String(user.id), updatedAt: new Date().toISOString() };
+    data.chats = data.chats || []; data.chats.push(chat);
+    data.chat_participants = data.chat_participants || []; data.chat_participants.push({ chat_id: chat.id, employee_id: String(user.id) });
+    save(); renderChats(); showToast("✅ Чат для задачи создан", "success");
+  }
+  
+  // 1. Переключаем главный раздел на "Компания"
+  const companyBtn = document.querySelector(".main-tabs button[onclick*='company']");
+  if (companyBtn) showMain("company", companyBtn);
+
+  // 2. Находим кнопку "Сообщения" в верхней панели и нажимаем её
+  const companyTabs = document.getElementById('company-tabs');
+  if (companyTabs) {
+    const chatBtn = Array.from(companyTabs.querySelectorAll('button')).find(b => b.textContent.includes('Сообщения'));
+    if (chatBtn) {
+      // Вызываем showCompanyTab, чтобы правильно переключить вкладку
+      showCompanyTab('chat', chatBtn);
+    }
+  }
+  
+  // 3. Открываем сам чат
+  _currentChatId = chat.id;
+  document.getElementById("chat_title").textContent = chat.title || "Без названия";
+  document.querySelector("#company-chat > .card").style.display = "none";
+  document.getElementById("chat_window").style.display = "block";
+  renderChatParticipants(chat.id);
+  renderChatMessages(chat.id);
+}
+5. Функция openSupplyChat
+Аналогично, должна корректно открывать чат из поставки.
+
+Замени функцию на эту:
+
+javascript
+function openSupplyChat(supplyId, title) {
+  const user = getCurrentUser(); if (!user) return;
+  let chat = (data.chats || []).find(c => String(c.linked_id) === String(supplyId));
+  
+  if (!chat) {
+    chat = { id: "c_" + Date.now() + "_" + Math.floor(Math.random()*1000), type: "task", title: "📦 Поставка: " + title, linked_id: String(supplyId), linked_type: "supply", pinned: false, created_by: String(user.id), updatedAt: new Date().toISOString() };
+    data.chats = data.chats || []; data.chats.push(chat);
+    data.chat_participants = data.chat_participants || []; data.chat_participants.push({ chat_id: chat.id, employee_id: String(user.id) });
+    save(); renderChats();
+  }
+  
+  // 1. Переключаем главный раздел на "Компания"
+  const companyBtn = document.querySelector(".main-tabs button[onclick*='company']");
+  if (companyBtn) showMain("company", companyBtn);
+
+  // 2. Находим кнопку "Сообщения" в верхней панели и нажимаем её
+  const companyTabs = document.getElementById('company-tabs');
+  if (companyTabs) {
+    const chatBtn = Array.from(companyTabs.querySelectorAll('button')).find(b => b.textContent.includes('Сообщения'));
+    if (chatBtn) {
+      showCompanyTab('chat', chatBtn);
+    }
+  }
+  
+  // 3. Открываем сам чат
+  _currentChatId = chat.id;
+  document.getElementById("chat_title").textContent = chat.title || "Без названия";
+  document.querySelector("#company-chat > .card").style.display = "none";
+  document.getElementById("chat_window").style.display = "block";
+  renderChatParticipants(chat.id);
+  renderChatMessages(chat.id);
+}
+
+
+Проверь все ли кнопки и математика учёта находят правильные новые пути

