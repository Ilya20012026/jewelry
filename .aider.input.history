+  .progress-track { display: flex; align-items: center; justify-content: space-between; margin: 12px 0; position: relative; }
+  .progress-track::before { content: ''; position: absolute; top: 50%; left: 10px; right: 10px; height: 2px; background: rgba(255,255,255,0.1); z-index: 1; transform: translateY(-50%); }
+  .progress-step { width: 24px; height: 24px; border-radius: 50%; background: #16161a; border: 2px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.5); position: relative; z-index: 2; transition: all 0.3s ease; }
+  .progress-step.done { background: var(--accent); border-color: var(--accent); color: #fff; }
+  .progress-step.current { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.2); }
+
+  .chat-item { display: flex; align-items: center; justify-content: space-between; padding: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--r-md); margin-bottom: 8px; cursor: pointer; transition: background .15s; }
+  .chat-item:hover { background: rgba(255,255,255,0.08); }
+  .chat-item.pinned { border-left: 3px solid var(--accent); }
+  .chat-item-info { display: flex; flex-direction: column; gap: 4px; }
+  .chat-item-title { font-size: 14px; font-weight: 500; color: #fff; }
+  .chat-item-meta { font-size: 11px; color: rgba(255,255,255,0.5); }
+  .chat-item-badge { background: var(--accent); color: #fff; font-size: 10px; padding: 2px 8px; border-radius: 10px; }
+
+  .chat-message { padding: 12px 16px; margin-bottom: 10px; border-radius: var(--r-md); background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.05); max-width: 80%; word-wrap: break-word; }
+  .chat-message.own { background: var(--accent); color: #fff; margin-left: auto; border-color: var(--accent); }
+  .chat-message-header { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; margin-bottom: 6px; color: rgba(255,255,255,0.5); }
+  .chat-message.own .chat-message-header { color: rgba(255,255,255,0.8); }
+  .chat-message-sender { font-weight: 600; }
+  .chat-message-text { font-size: 13px; line-height: 1.5; }
+
+  /* МОДАЛКИ В ТЕМНОМ СТИЛЕ */
+  #task_modal > div, #product_modal > div, #employee_modal > div, #contractor_modal > div, #archived_supply_modal > div {
+    background: #16161a !important; color: #fff !important; border: 1px solid var(--border-light);
+  }
+  #task_modal h3, #product_modal h3, #employee_modal h3, #contractor_modal h3 { color: #fff; border-bottom-color: rgba(255,255,255,0.1); }
+  #task_modal label, #product_modal label { color: rgba(255,255,255,0.5) !important; }
+  #task_modal table th, #product_modal table th { color: rgba(255,255,255,0.4); background: transparent; }
+  #task_modal table td, #product_modal table td { border-bottom-color: rgba(255,255,255,0.05); color: rgba(255,255,255,0.7); }
+  #task_modal button[onclick="closeTaskModal()"], #product_modal button[onclick="closeProductModal()"] { color: #fff; }
+
+  /* АДАПТИВ ПОД МОБИЛЬНЫЕ */
+  @media (max-width: 900px) {
+    header { padding: 0 16px; height: 64px; }
+    .main-tabs { padding: 0 16px; height: 48px; }
+    .tabs { padding: 12px 16px; }
+    .main-section { padding: 16px 16px 40px 16px; }
+    .card { padding: 20px; border-radius: var(--r-lg); margin-bottom: 16px; }
+    
+    .calendar-grid { gap: 4px; }
+    .calendar-grid .day { min-height: 56px; padding: 6px; border-radius: var(--r-sm); }
+    .calendar-grid .day .day-number { font-size: 12px; }
+    
+    input, select, textarea, button.action { width: 100%; margin-bottom: 8px; }
+    .row { flex-direction: column; align-items: stretch; gap: 4px; }
+    
+    table { display: block; overflow-x: auto; white-space: nowrap; }
+    
+    #task_modal > div, #product_modal > div, #employee_modal > div, #contractor_modal > div, #archived_supply_modal > div {
+      width: 100% !important; max-width: 100% !important; height: 100% !important; max-height: 100% !important; border-radius: 0 !important; padding: 16px !important;
+    }
+  }

