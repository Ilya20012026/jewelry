# 2026-10-23 03:54:08.799349
+Привет, Aider! Осталась одна критическая ошибка: при открытии любого чата поверх него накладывается окно календаря. Это происходит из-за того, что функция openChat неправильно переключает вкладки в новой структуре DOM.
+
+Замени функцию openChat(chatId) на эту. В ней добавлено принудительное скрытие ВСЕХ вкладок в разделе "Компания" и активация только чата, а также правильный поиск кнопки в новой верхней панели:
+
+javascript
+function openChat(chatId) {
+  const user = getCurrentUser(); if (!user) return;
+  const chat = (data.chats || []).find(c => String(c.id) === String(chatId));
+  if (!chat) return alert("Чат не найден");
+  
+  // 1. Переключаем главный раздел на "Компания"
+  const companyBtn = document.querySelector(".main-tabs button[onclick*='company']");
+  if (companyBtn) showMain("company", companyBtn);
+  
+  // 2. Принудительно скрываем ВСЕ вкладки внутри раздела "Компания"
+  document.querySelectorAll("#main-company .tab").forEach(t => t.classList.remove("active"));
+  
+  // 3. Снимаем активность со всех кнопок в верхней панели (company-tabs)
+  const companyTabs = document.getElementById('company-tabs');
+  if (companyTabs) {
+    companyTabs.querySelectorAll('button').forEach(b => b.classList.remove('active'));
+  }
+
+  // 4. Включаем только вкладку "Сообщения"
+  const chatTab = document.getElementById("company-chat");
+  if (chatTab) chatTab.classList.add("active");
+  
+  // 5. Активируем кнопку "Сообщения" в верхней панели
+  if (companyTabs) {
+    const chatBtn = Array.from(companyTabs.querySelectorAll('button')).find(b => b.textContent.includes('Сообщения'));
+    if (chatBtn) chatBtn.classList.add('active');
+  }
+
+  // 6. Устанавливаем ID чата и показываем окно переписки
+  _currentChatId = chatId;
+  document.getElementById("chat_title").textContent = chat.title || "Без названия";
+  
+  // Скрываем карточку со списком чатов и показываем окно чата
+  const chatListCard = document.querySelector("#company-chat > .card");
+  if (chatListCard) chatListCard.style.display = "none";
+  document.getElementById("chat_window").style.display = "block";
+  
+  renderChatParticipants(chatId);
+  renderChatMessages(chatId);
+  setTimeout(() => { const inp = document.getElementById("chat_input"); if (inp) inp.focus(); }, 100);
+}
+Также проверь функцию closeChatWindow(). Она должна выглядеть так:
+
+javascript
+function closeChatWindow() {
+  _currentChatId = null;
+  document.getElementById("chat_window").style.display = "none";
+  
+  // Возвращаем карточку со списком чатов
+  const chatListCard = document.querySelector("#company-chat > .card");
+  if (chatListCard) chatListCard.style.display = "block";
+  
+  // Если мы не в архиве чатов, перерисовываем основной список
+  const archivedChatsTab = document.getElementById("service-archive_chats");
+  if (!archivedChatsTab || !archivedChatsTab.classList.contains("active")) {
+    renderChats();
+  }
+}
+Выполни эти замены. Теперь при клике на чат календарь будет гарантированно скрываться, и откроется только окно переписки.

