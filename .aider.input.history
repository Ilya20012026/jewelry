+      <span id="s4_theoretical_${b.id}" style="font-weight:600; color:#2b6cb0;"></span>
+      <input id="s4_used_${b.id}" type="number" step="0.001" placeholder="Факт. использовано, г">
+      <input id="s4_ret_${b.id}" type="number" step="0.001" placeholder="Возврат, г" value="0">
+      <input type="file" id="s4_photo_${b.id}" accept="image/*" style="display:none" onchange="uploadStagePhoto('${b.id}', 4, this)">
+      <button class="action" onclick="document.getElementById('s4_photo_${b.id}').click()">📷 Фото</button>
+      <button class="action ok" onclick="completeStage4(${b.id})">Этап завершён</button>
+    </div>`;
+  }
+  html += `</div>`;
+} else if (s[4].done) {
+  html += `<div class="stage done"><div class="stage-title">4. Литьё <span class="badge badge-done">завершён</span></div><div class="stage-info">Использовано: ${fmt(s[4].metalUsed,3)} г, возврат: ${fmt(s[4].metalReturned,3)} г — ${fmt(b.stageCosts[4])} ₽</div></div>`;
+}
+
+10. Добавь новую функцию после renderBatchCard:
+function calcTheoreticalMetal(bid) {
+  const b = data.batches.find(x => String(x.id) === String(bid));
